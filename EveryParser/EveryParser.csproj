<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Authors>Andreas Burbach, Joram Stiel</Authors>
    <Company />
    <Product>EveryParser.Net</Product>
    <Description>Parser for everything in you life!</Description>
    <Copyright>Andreas Burbach, Joram Stiel</Copyright>
    <RepositoryUrl>https://github.com/AndreasBurbach/EveryParser.Net</RepositoryUrl>
    <PackageProjectUrl>https://github.com/AndreasBurbach/EveryParser.Net</PackageProjectUrl>
    <RepositoryType>GitHub</RepositoryType>
    <PackageTags>Expression, Parser, Math</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <SignAssembly>false</SignAssembly>
    <PackageId>EveryParser.Net</PackageId>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.2.0</Version>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
	<!-- Doc warnings suppressed: public API is not fully documented yet; CS0419/CS0114 originate from generated ANTLR code -->
	<NoWarn>$(NoWarn);CS1591;CS1572;CS1573;CS1570;CS0419;CS0114</NoWarn>
    <!-- Source link & deterministic builds: reproducible packages with debuggable symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
	
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
